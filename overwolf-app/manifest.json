{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "SCC VAL HUD Link",
    "author": "St. Clair Saints",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.160.0",
    "description": "Sends VALORANT's game events to the SCC VAL HUD on this PC.",
    "dock_button_title": "SCC VAL HUD",
    "icon": "icon.png",
    "icon_gray": "icon_gray.png",
    "launcher_icon": "icon.ico",
    "window_icon": "icon.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640]
    },
    "game_events": [21640],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [21640] },
        "start_minimized": true
      }
    ]
  }
}
