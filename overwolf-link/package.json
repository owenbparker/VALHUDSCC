{
  "name": "scc-val-overwolf-link",
  "productName": "SCC VAL Overwolf Link",
  "version": "1.0.0",
  "description": "Sends VALORANT's game events (Overwolf) to the SCC VAL HUD. No Overwolf install needed.",
  "author": { "name": "St. Clair Saints" },
  "license": "UNLICENSED",
  "main": "main.js",
  "overwolf": {
    "packages": ["gep"]
  },
  "scripts": {
    "start": "ow-electron .",
    "start:test-channel": "ow-electron . --owepm-package-channel=gep:dev",
    "build": "ow-electron-builder --win portable --publish=never"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "37.10.3",
    "@overwolf/ow-electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.stclairsaints.val-overwolf-link",
    "productName": "SCC VAL Overwolf Link",
    "files": ["main.js", "preload.js", "index.html", "icon.png"],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "SCC-VAL-Overwolf-Link.exe"
    }
  }
}
